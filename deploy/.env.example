# Copy to deploy/.env and adjust before starting the stack.
#
# Every address the reverse proxy answers on, comma-separated.
#   LAN/VPN pilot: include the host's LAN IPs so phones/laptops can reach the
#   app directly (`radar.localhost` only resolves on the host itself). TLS is
#   self-signed (`tls internal` in Caddyfile) — testers accept it once.
#   Check the host addresses with: ip -4 -o addr show
#   Cloud/path B: replace with the real domain only, e.g. radar.example.com
CADDY_SITE_ADDRESSES=radar.localhost, https://192.168.1.9, https://192.168.1.7

# Certificate used when a client sends no SNI — which is what browsers and curl
# do for bare-IP URLs. Without it Caddy aborts those handshakes with a TLS
# internal_error (Chrome: ERR_SSL_PROTOCOL_ERROR). Point it at the hostname
# whose certificate should be served by default. Cloud/path B: the real domain.
CADDY_DEFAULT_SNI=radar.localhost

# Only used for Let's Encrypt when CADDY_SITE_ADDRESSES is a real public domain
# (cloud path B). Leave empty for the LAN pilot.
CADDY_EMAIL=

# Basic-auth login for testers. The hash is a Caddy bcrypt hash:
#   deploy/hash-password.sh 'your-password'
RADAR_AUTH_USER=radiologist
# RADAR_AUTH_HASH is a Caddy bcrypt hash. IMPORTANT: Compose interpolates
# '$' in .env values, so escape every '$' as '$$' (e.g. '$2a$14$A/...' ->
# '$$2a$$14$$A/...'). Generate with:
#   deploy/hash-password.sh 'your-password'
RADAR_AUTH_HASH=